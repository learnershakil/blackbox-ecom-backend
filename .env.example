# Test Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://admin:secret@localhost:27017

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-development-only
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=test-refresh-secret-key-for-development-only
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Configuration (placeholder)
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# Gmail Configuration
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Payment Configuration (placeholder)
RAZORPAY_KEY_ID=test-razorpay-key
RAZORPAY_KEY_SECRET=test-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret

# Logging Configuration
